# Per-user state — never commit the user's stickers
input/*
output/*
archive/*
!input/.gitkeep
!output/.gitkeep
!archive/.gitkeep

# Script state
.output_counter

# macOS / editors
.DS_Store
.vscode/

# Claude Code: ignore personal state, but ship the bundled skill
# (also overrides a global ~/.gitignore rule that ignores .claude/skills/*)
.claude/*
!.claude/skills/
!.claude/skills/**
